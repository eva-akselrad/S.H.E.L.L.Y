# WeatherNow Environment Configuration

# === AUTHENTICATION ===
# Admin panel login password (separate from CS242 password for security)
ADMIN_PASSWORD=weathernow

# CS242 Security Demo password (used for both demo panel access AND lockout bypass)
# Different from ADMIN_PASSWORD so compromised demo password doesn't expose admin panel
CS242_PASSWORD=cs242-security

# === JWT & SECURITY ===
# JWT secret for session tokens (auto-generated if not set)
# JWT_SECRET=your-random-secret-key

# === WEB PUSH NOTIFICATIONS ===
# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_EMAIL=mailto:admin@example.com

# === DEPLOYMENT ===
# Environment mode: 'development' or 'production'
NODE_ENV=development

# Port for local development
PORT=3000

# === FEATURE FLAGS ===
# Enable/disable security demo panel at /cs242
SECURITY_DEMO_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# IMPORTANT: 
# - ADMIN_PASSWORD: Used for /admin panel login only
# - CS242_PASSWORD: Used for:
#   1. Accessing /cs242 demo panel (query param: ?password=...)
#   2. Bypassing IP lockout (full-site block after 5 failed logins)
# 
# - In PRODUCTION, set both to secure random values
# - Do NOT commit .env to version control (use .env.example instead)
# - For Cloudflare Pages, add these as secret environment variables
# ═══════════════════════════════════════════════════════════════
