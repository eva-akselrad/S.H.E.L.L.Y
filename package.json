{
  "name": "shelly",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SHELLY – Severe Hydrology & Environmental Live Logging Yearbook",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-playlist.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "leaflet": "^1.9.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
