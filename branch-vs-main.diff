+                            <span style="color:var(--accent2);flex:0 0 110px;overflow:hidden;text-overflow:ellipsis">${esc(e.ip)}</span>
+                            <span style="color:var(--muted);overflow:hidden;text-overflow:ellipsis">${esc(e.path)}${e.detail ? ' · ' + esc(e.detail) : ''}</span>
+                        </div>`;
+                    }).join('');
+                } catch {
+                    statsEl.innerHTML = '';
+                    evEl.innerHTML = '<div class="no-msgs">Could not load security log</div>';
+                }
+            }
+
             function esc(s) {
                 return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
             }
